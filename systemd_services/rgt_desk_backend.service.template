# Template: install.sh substitutes the @PLACEHOLDER@s and writes the rendered
# unit to /etc/systemd/system. Do not symlink this file directly.

[Unit]
Description=RGT Desk Backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
LimitRTPRIO=99
WorkingDirectory=@REPO_DIR@/rgt_desk_backend
Environment=PYTHONUNBUFFERED=1
Environment=ROS_DOMAIN_ID=19
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
@FASTRTPS_LINE@
Environment="PATH=@REPO_DIR@/rgt_desk_backend/.venv/bin:/usr/bin:/usr/local/bin:/bin"
ExecStart=/bin/bash -c "source /opt/ros/jazzy/setup.bash && source @ROS2_WS@/install/setup.bash && exec @REPO_DIR@/rgt_desk_backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000"
Restart=always

[Install]
WantedBy=multi-user.target
