# Template: install.sh substitutes the @PLACEHOLDER@s and writes the rendered
# unit to /etc/systemd/system. Do not symlink this file directly.

[Unit]
Description=RGT Desk Frontend
After=network.target

[Service]
User=@USER@
WorkingDirectory=@REPO_DIR@/rgt_desk_frontend
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# install.sh links the host's active node and npm into /usr/local/bin,
# so this survives nvm version changes and works without nvm at all.
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Absolute paths so systemd can launch npm directly
ExecStartPre=/usr/local/bin/npm install
ExecStartPre=/usr/local/bin/npm run build
ExecStart=/usr/local/bin/npm run preview -- --port 80 --host 0.0.0.0

Restart=always
# npm install and build happen on every startup
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
